{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb-template.schema.json",
  "title": "template (KB)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "$ref": "scope.schema.json"
    },
    {
      "$ref": "time.schema.json"
    },
    {
      "$ref": "provenance.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(KB)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "const": "template"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "deliverable": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "elements": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        }
      },
      "required": [
        "name",
        "deliverable",
        "location",
        "elements"
      ]
    }
  ],
  "unevaluatedProperties": false
}
