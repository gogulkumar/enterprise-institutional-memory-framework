{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb-business-event.schema.json",
  "title": "business_event (KB)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "$ref": "scope.schema.json"
    },
    {
      "$ref": "time.schema.json"
    },
    {
      "$ref": "provenance.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(KB)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "const": "business_event"
        },
        "event_id": {
          "type": "string",
          "pattern": "^EVT-\\d{4}(-Q[1-4]|-\\d{2}(-\\d{2})?)?-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "what_happened": {
          "type": "string",
          "minLength": 1
        },
        "periods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\d{4}(-Q[1-4]|-\\d{2}(-\\d{2})?)?$"
          }
        },
        "affected": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(KB)-[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "event_id",
        "what_happened",
        "periods",
        "affected",
        "outcome"
      ]
    }
  ],
  "unevaluatedProperties": false
}
