{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thinking-pattern.schema.json",
  "title": "thinking_pattern (TP)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "$ref": "scope.schema.json"
    },
    {
      "$ref": "time.schema.json"
    },
    {
      "$ref": "governed.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(TP)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "const": "thinking_pattern"
        },
        "situation": {
          "type": "string",
          "minLength": 1
        },
        "first_questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "suspicion_triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hypotheses_in_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "why_this_order": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hypothesis",
              "look_at",
              "confirms_if",
              "rules_out_if"
            ],
            "properties": {
              "hypothesis": {
                "type": "string",
                "minLength": 1
              },
              "look_at": {
                "type": "string",
                "minLength": 1
              },
              "confirms_if": {
                "type": "string",
                "minLength": 1
              },
              "rules_out_if": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "stop_when": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "traps_i_avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "judgments_applied": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(JD)-[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "conditions": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        }
      },
      "required": [
        "situation",
        "first_questions",
        "suspicion_triggers",
        "hypotheses_in_order",
        "why_this_order",
        "checks",
        "stop_when",
        "traps_i_avoid",
        "judgments_applied",
        "conditions"
      ]
    }
  ],
  "unevaluatedProperties": false
}
