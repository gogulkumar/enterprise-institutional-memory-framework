{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "src-approved-location.schema.json",
  "title": "approved_location (SRC)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(SRC)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "const": "approved_location"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "what_it_holds": {
          "type": "string",
          "minLength": 1
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "location",
        "what_it_holds",
        "approved_by",
        "approved_on"
      ]
    }
  ],
  "unevaluatedProperties": false
}
