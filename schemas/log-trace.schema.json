{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log-trace.schema.json",
  "title": "trace (TR)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(TR)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "const": "trace"
        },
        "source": {
          "enum": [
            "file_reconstruction",
            "correction",
            "interview",
            "think_aloud",
            "scenario",
            "note"
          ]
        },
        "trace_id": {
          "type": "string",
          "pattern": "^(TR)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "task_or_question": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "looked_at": {
                "type": "string",
                "minLength": 1
              },
              "because": {
                "type": "string",
                "minLength": 1
              },
              "noticed": {
                "type": "string",
                "minLength": 1
              },
              "thought": {
                "type": "string",
                "minLength": 1
              },
              "did_next": {
                "type": "string",
                "minLength": 1
              },
              "predicted": {
                "type": "string",
                "minLength": 1
              },
              "match": {
                "type": "boolean"
              }
            }
          }
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "response": {
          "type": "string",
          "minLength": 1
        },
        "extracted_into": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(BV|TP|JD|RS|KB|DM|PR|SRC|TR|Q|CH|TS|RN)-[0-9A-HJKMNP-TV-Z]{26}$"
          }
        }
      },
      "required": [
        "source",
        "date",
        "task_or_question",
        "steps",
        "conclusion",
        "extracted_into"
      ]
    }
  ],
  "unevaluatedProperties": false
}
