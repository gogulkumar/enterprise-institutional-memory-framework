{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scope.schema.json",
  "title": "Scope block; empty lists mean everywhere",
  "type": "object",
  "required": [
    "scope"
  ],
  "properties": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "situations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "periods": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}(-Q[1-4]|-\\d{2}(-\\d{2})?)?$"
          }
        }
      }
    }
  }
}
