{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "match-ledger-row.schema.json",
  "title": "Match ledger row: how one Learn signal was routed (SPEC 9, step 6)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pass_id",
    "signal",
    "matched_entry",
    "action"
  ],
  "properties": {
    "pass_id": {
      "type": "string",
      "pattern": "^LP-[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "signal": {
      "type": "string",
      "minLength": 1
    },
    "matched_entry": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(BV|TP|JD|RS|KB|DM|PR|SRC|TR|Q|CH|TS|RN)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "enum": [
        "confirm",
        "contradict",
        "refine",
        "new_observation"
      ]
    }
  }
}
