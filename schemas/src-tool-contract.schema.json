{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "src-tool-contract.schema.json",
  "title": "tool_contract (SRC)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(SRC)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "const": "tool_contract"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "can_establish": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cannot_establish": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "access_boundary": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tool",
        "capability",
        "inputs",
        "outputs",
        "can_establish",
        "cannot_establish",
        "access_boundary"
      ]
    }
  ],
  "unevaluatedProperties": false
}
