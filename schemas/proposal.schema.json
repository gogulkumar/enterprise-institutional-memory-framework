{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proposal.schema.json",
  "title": "Proposal, one file per change in brain/proposals/ (SPEC 12.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "target",
    "payload",
    "evidence",
    "needs_ratification"
  ],
  "properties": {
    "action": {
      "enum": [
        "create",
        "confirm",
        "contradict",
        "promote",
        "demote",
        "replace",
        "retire",
        "redefine"
      ]
    },
    "target": {
      "type": "string",
      "pattern": "^(BV|TP|JD|RS|KB|DM|PR|SRC|TR|Q|CH|TS|RN)-([0-9A-HJKMNP-TV-Z]{26}|new)$"
    },
    "payload": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^(SRC)-[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "event_id": {
            "type": "string",
            "pattern": "^EVT-\\d{4}(-Q[1-4]|-\\d{2}(-\\d{2})?)?-[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        }
      }
    },
    "needs_ratification": {
      "type": "boolean"
    }
  }
}
