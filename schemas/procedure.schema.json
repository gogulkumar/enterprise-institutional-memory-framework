{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "procedure.schema.json",
  "title": "procedure (PR)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "$ref": "scope.schema.json"
    },
    {
      "$ref": "time.schema.json"
    },
    {
      "$ref": "governed.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(PR)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "const": "procedure"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(KB)-[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "output_pattern": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object"
            }
          ]
        },
        "format_rules": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "example_with_blanks": {
          "type": "string",
          "minLength": 1
        },
        "self_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "purpose",
        "inputs",
        "steps",
        "output_pattern",
        "format_rules",
        "example_with_blanks",
        "self_checks"
      ]
    }
  ],
  "unevaluatedProperties": false
}
