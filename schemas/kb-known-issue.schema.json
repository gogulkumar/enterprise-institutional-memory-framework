{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb-known-issue.schema.json",
  "title": "known_issue (KB)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "$ref": "scope.schema.json"
    },
    {
      "$ref": "time.schema.json"
    },
    {
      "$ref": "provenance.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(KB)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "const": "known_issue"
        },
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "how_to_detect": {
          "type": "string",
          "minLength": 1
        },
        "what_to_do": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "problem",
        "when",
        "how_to_detect",
        "what_to_do"
      ]
    }
  ],
  "unevaluatedProperties": false
}
