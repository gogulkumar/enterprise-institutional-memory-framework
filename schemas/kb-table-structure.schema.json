{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb-table-structure.schema.json",
  "title": "table_structure (KB)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "$ref": "scope.schema.json"
    },
    {
      "$ref": "time.schema.json"
    },
    {
      "$ref": "provenance.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(KB)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "const": "table_structure"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "one_row_is": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "definition"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "totals_check": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        }
      },
      "required": [
        "name",
        "one_row_is",
        "columns",
        "totals_check"
      ]
    }
  ],
  "unevaluatedProperties": false
}
