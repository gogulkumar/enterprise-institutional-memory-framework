{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb-deliverable-profile.schema.json",
  "title": "deliverable_profile (KB)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "$ref": "scope.schema.json"
    },
    {
      "$ref": "time.schema.json"
    },
    {
      "$ref": "provenance.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(KB)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "const": "deliverable_profile"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "cadence_and_due": {
          "type": "string",
          "minLength": 1
        },
        "data_cutoff": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "comparison_basis": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(BV|TP|JD|RS|KB|DM|PR|SRC|TR|Q|CH|TS|RN)-[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "structure": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "fed_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "feeds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review": {
          "type": "string",
          "minLength": 1
        },
        "done_when": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "procedures": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(PR)-[0-9A-HJKMNP-TV-Z]{26}$"
          }
        }
      },
      "required": [
        "name",
        "purpose",
        "components",
        "cadence_and_due",
        "data_cutoff",
        "audience",
        "comparison_basis",
        "inputs",
        "structure",
        "fed_by",
        "feeds",
        "review",
        "done_when",
        "procedures"
      ]
    }
  ],
  "unevaluatedProperties": false
}
