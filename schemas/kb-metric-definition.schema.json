{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kb-metric-definition.schema.json",
  "title": "metric_definition (KB)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "$ref": "scope.schema.json"
    },
    {
      "$ref": "time.schema.json"
    },
    {
      "$ref": "provenance.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(KB)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "const": "metric_definition"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "source_of_truth": {
          "type": "string",
          "minLength": 1
        },
        "compare_to": {
          "type": "string",
          "minLength": 1
        },
        "join": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "filters": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "sign": {
          "type": "string",
          "minLength": 1
        },
        "breaks_down_as": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "validated": {
          "enum": [
            "yes",
            "no",
            "on_snapshot",
            "no_access"
          ]
        }
      },
      "required": [
        "name",
        "meaning",
        "source_of_truth",
        "validated"
      ]
    }
  ],
  "unevaluatedProperties": false
}
