{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "src-artifact.schema.json",
  "title": "artifact (SRC)",
  "type": "object",
  "allOf": [
    {
      "$ref": "base.schema.json"
    },
    {
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(SRC)-[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "kind": {
          "const": "artifact"
        },
        "type": {
          "enum": [
            "commentary",
            "slides",
            "model",
            "email",
            "query_history",
            "draft",
            "note",
            "chat",
            "transcript",
            "correction",
            "other",
            "filing",
            "dataset"
          ]
        },
        "business_area": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "pattern": "^\\d{4}(-Q[1-4]|-\\d{2}(-\\d{2})?)?$"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EVT-\\d{4}(-Q[1-4]|-\\d{2}(-\\d{2})?)?-[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "doc_version": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "approved_location": {
          "type": "boolean"
        },
        "authority_rank": {
          "enum": [
            "owner_statement",
            "owner_working_trace",
            "owner_finished_work",
            "other_people",
            "inference",
            "system_of_record"
          ]
        },
        "deliverable": {
          "type": "string",
          "minLength": 1
        },
        "can_teach": {
          "type": "array",
          "items": {
            "enum": [
              "business_view",
              "thinking_patterns",
              "judgments",
              "response_style",
              "knowledge_base",
              "dependency_map",
              "procedures"
            ]
          }
        },
        "cannot_teach": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "serves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "A",
              "B",
              "C",
              "none"
            ]
          }
        }
      },
      "required": [
        "type",
        "business_area",
        "period",
        "author",
        "event_ids",
        "location",
        "approved_location",
        "authority_rank",
        "can_teach",
        "cannot_teach",
        "serves"
      ]
    }
  ],
  "unevaluatedProperties": false
}
