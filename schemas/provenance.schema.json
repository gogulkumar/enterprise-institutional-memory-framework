{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provenance.schema.json",
  "title": "Provenance only (knowledge base entries, SPEC 6.1)",
  "type": "object",
  "required": [
    "provenance"
  ],
  "properties": {
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^(SRC)-[0-9A-HJKMNP-TV-Z]{26}$"
          },
          {
            "type": "string",
            "pattern": "^owner:.+$"
          }
        ]
      }
    }
  }
}
