{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governed.schema.json",
  "title": "Governed block",
  "type": "object",
  "required": [
    "provenance",
    "trust",
    "sureness",
    "owner",
    "events",
    "last_confirmed_by_owner"
  ],
  "properties": {
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^(SRC)-[0-9A-HJKMNP-TV-Z]{26}$"
          },
          {
            "type": "string",
            "pattern": "^owner:.+$"
          }
        ]
      }
    },
    "trust": {
      "enum": [
        "observation",
        "candidate",
        "established",
        "contested",
        "replaced",
        "retired"
      ]
    },
    "sureness": {
      "enum": [
        "stated",
        "checked",
        "inferred"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVT-\\d{4}(-Q[1-4]|-\\d{2}(-\\d{2})?)?-[A-Za-z0-9][A-Za-z0-9_-]*$"
      }
    },
    "last_confirmed_by_owner": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "const": "never"
        }
      ]
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(Q)-[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(BV|TP|JD|RS|KB|DM|PR|SRC|TR|Q|CH|TS|RN)-[0-9A-HJKMNP-TV-Z]{26}$"
      }
    }
  }
}
